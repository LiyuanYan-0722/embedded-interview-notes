#include <stdio.h>
#include <math.h>

int main() {
// Convert binary to decimal
// Binary 11010 to Decimal
// 2^0 * 0 + 2^1 * 1 + 2^2 * 0 + 2^3 * 1 + 2^4 * 1

int N, decimal_dig = 0, result = 0, power = 0;
printf("Please enter a Binary number:");
scanf("%d", &N);
printf("The Binary number you entered is:%d\n", N);

int last_dig =0;
while(N > 0) {
    last_dig = N % 10;
    decimal_dig = last_dig * pow(2,power);
    power++;
    N = N / 10;
    result += decimal_dig; 
}
printf("%d", result);
return 0;
}
