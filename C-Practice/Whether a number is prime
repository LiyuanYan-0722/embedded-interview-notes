#include <stdio.h>

int main() {
    int n;
    //check whether a number is prime or not
    printf("Enter a number: ");
    scanf("%d", &n);
    printf("You entered: %d\n", n);
    
    int count = 0;
    if (n <= 1) {
        printf("%d is not prime", n);
    }
    for(int i = 1; i <= n; i++){
        if (n % i == 0){
            count++;
        }
    }
    
    if (count == 2) {
            printf("%d is prime\n", n);
    } else {
        printf("%d is not prime", n);
    }
    return 0;
} 
