#include <stdio.h>
#include <math.h>

int main() {
// replace all 0's with 1's
int N = 0;
printf("Please enter an integer: ");
scanf("%d", &N);
printf("You entered: %d\n", N);

int last_dig = 0, place = 1, result = 0;

for(int i = 0; i < N; i++) {
    last_dig = N % 10;
    N = N /10;
    // printf("%d", last_dig);
    if(last_dig == 0) {
       last_dig = 1;
    }
    //printf("%d\n", last_dig);
    //printf("%d\n", place);
    result = result + last_dig * place;
    place = place * 10;
}

printf("After replacing: %d", result);
}
